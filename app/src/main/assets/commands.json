{
  "schemaVersion": 1,
  "configVersion": 1,
  "minimumAppVersion": 1,
  "apps": [
    {
      "id": "youtube",
      "packageName": "com.google.android.youtube",
      "aliases": [
        "youtube",
        "you tube"
      ]
    },
    {
      "id": "youtube_music",
      "packageName": "com.google.android.apps.youtube.music",
      "aliases": [
        "youtube music",
        "you tube music"
      ]
    },
    {
      "id": "maps",
      "packageName": "com.google.android.apps.maps",
      "aliases": [
        "maps",
        "google map",
        "google maps",
        "bản đồ"
      ]
    },
    {
      "id": "chrome",
      "packageName": "com.android.chrome",
      "aliases": [
        "chrome",
        "google chrome",
        "trình duyệt"
      ]
    },
    {
      "id": "spotify",
      "packageName": "com.spotify.music",
      "aliases": [
        "spotify"
      ]
    },
    {
      "id": "facebook",
      "packageName": "com.facebook.katana",
      "aliases": [
        "facebook",
        "face book"
      ]
    },
    {
      "id": "tiktok",
      "packageName": "com.zhiliaoapp.musically",
      "aliases": [
        "tiktok",
        "tik tok"
      ]
    }
  ],
  "commands": [
    {
      "id": "open_app",
      "action": "APP_LAUNCH",
      "patterns": [
        "mở {app}",
        "bật {app}",
        "khởi động {app}",
        "mở ứng dụng {app}",
        "chuyển sang {app}",
        "mở lại {app}"
      ],
      "slots": {
        "app": {
          "type": "APP_ALIAS",
          "required": true
        }
      }
    },
    {
      "id": "split_app_pair",
      "action": "APP_PAIR_LAUNCH",
      "patterns": [
        "chia màn hình {firstApp} và {secondApp}",
        "chia đôi màn hình {firstApp} với {secondApp}",
        "mở song song {firstApp} và {secondApp}"
      ],
      "allowCompound": true,
      "slots": {
        "firstApp": { "type": "APP_ALIAS", "required": true },
        "secondApp": { "type": "APP_ALIAS", "required": true }
      }
    },
    {
      "id": "wifi_on",
      "action": "WIFI_SET",
      "patterns": [
        "bật wifi",
        "bật wi-fi",
        "mở wifi",
        "mở wi-fi"
      ],
      "args": {
        "enabled": true
      }
    },
    {
      "id": "wifi_off",
      "action": "WIFI_SET",
      "patterns": [
        "tắt wifi",
        "tắt wi-fi"
      ],
      "args": {
        "enabled": false
      }
    },
    {
      "id": "bluetooth_on",
      "action": "BLUETOOTH_SET",
      "patterns": [
        "bật bluetooth",
        "mở bluetooth"
      ],
      "args": {
        "enabled": true
      }
    },
    {
      "id": "bluetooth_off",
      "action": "BLUETOOTH_SET",
      "patterns": [
        "tắt bluetooth"
      ],
      "args": {
        "enabled": false
      }
    },
    {
      "id": "volume_percent",
      "action": "VOLUME_SET",
      "patterns": [
        "đặt âm lượng {percent}",
        "đặt âm lượng lên {percent}",
        "đặt âm lượng xuống {percent}",
        "đặt âm lượng đến {percent}",
        "đặt âm lượng về {percent}",
        "chỉnh âm lượng {percent}",
        "chỉnh âm lượng lên {percent}",
        "chỉnh âm lượng xuống {percent}",
        "chỉnh âm lượng đến {percent}",
        "chỉnh âm lượng về {percent}",
        "điều chỉnh âm lượng {percent}",
        "điều chỉnh âm lượng lên {percent}",
        "điều chỉnh âm lượng xuống {percent}",
        "điều chỉnh âm lượng đến {percent}",
        "điều chỉnh âm lượng về {percent}",
        "tăng âm lượng {percent}",
        "tăng âm lượng lên {percent}",
        "tăng âm lượng xuống {percent}",
        "tăng âm lượng đến {percent}",
        "tăng âm lượng về {percent}",
        "giảm âm lượng {percent}",
        "giảm âm lượng lên {percent}",
        "giảm âm lượng xuống {percent}",
        "giảm âm lượng đến {percent}",
        "giảm âm lượng về {percent}"
      ],
      "slots": {
        "percent": {
          "type": "PERCENT",
          "required": true
        }
      },
      "args": {
        "operation": "SET"
      }
    },
    {
      "id": "volume_increase",
      "action": "VOLUME_SET",
      "patterns": [
        "tăng âm lượng"
      ],
      "args": {
        "operation": "INCREASE",
        "steps": 1
      }
    },
    {
      "id": "volume_increase_steps",
      "action": "VOLUME_SET",
      "patterns": [
        "tăng âm lượng {steps} bước"
      ],
      "slots": {
        "steps": {
          "type": "INTEGER",
          "required": true
        }
      },
      "args": {
        "operation": "INCREASE"
      }
    },
    {
      "id": "volume_decrease",
      "action": "VOLUME_SET",
      "patterns": [
        "giảm âm lượng"
      ],
      "args": {
        "operation": "DECREASE",
        "steps": 1
      }
    },
    {
      "id": "volume_decrease_steps",
      "action": "VOLUME_SET",
      "patterns": [
        "giảm âm lượng {steps} bước"
      ],
      "slots": {
        "steps": {
          "type": "INTEGER",
          "required": true
        }
      },
      "args": {
        "operation": "DECREASE"
      }
    },
    {
      "id": "brightness_percent",
      "action": "BRIGHTNESS_SET",
      "patterns": [
        "đặt độ sáng {percent}",
        "đặt độ sáng lên {percent}",
        "đặt độ sáng xuống {percent}",
        "đặt độ sáng đến {percent}",
        "đặt độ sáng về {percent}",
        "chỉnh độ sáng {percent}",
        "chỉnh độ sáng lên {percent}",
        "chỉnh độ sáng xuống {percent}",
        "chỉnh độ sáng đến {percent}",
        "chỉnh độ sáng về {percent}",
        "điều chỉnh độ sáng {percent}",
        "điều chỉnh độ sáng lên {percent}",
        "điều chỉnh độ sáng xuống {percent}",
        "điều chỉnh độ sáng đến {percent}",
        "điều chỉnh độ sáng về {percent}",
        "tăng độ sáng {percent}",
        "tăng độ sáng lên {percent}",
        "tăng độ sáng xuống {percent}",
        "tăng độ sáng đến {percent}",
        "tăng độ sáng về {percent}",
        "giảm độ sáng {percent}",
        "giảm độ sáng lên {percent}",
        "giảm độ sáng xuống {percent}",
        "giảm độ sáng đến {percent}",
        "giảm độ sáng về {percent}"
      ],
      "slots": {
        "percent": {
          "type": "PERCENT",
          "required": true
        }
      },
      "args": {
        "operation": "SET"
      }
    },
    {
      "id": "brightness_increase",
      "action": "BRIGHTNESS_SET",
      "patterns": [
        "tăng độ sáng"
      ],
      "args": {
        "operation": "INCREASE"
      }
    },
    {
      "id": "brightness_decrease",
      "action": "BRIGHTNESS_SET",
      "patterns": [
        "giảm độ sáng"
      ],
      "args": {
        "operation": "DECREASE"
      }
    },
    {
      "id": "mute",
      "action": "VOLUME_SET",
      "patterns": [
        "tắt tiếng",
        "tắt âm thanh",
        "tắt âm lượng"
      ],
      "args": {
        "operation": "MUTE"
      }
    },
    {
      "id": "unmute",
      "action": "VOLUME_SET",
      "patterns": [
        "bật tiếng",
        "bật âm thanh",
        "mở tiếng",
        "mở âm thanh",
        "bỏ tắt tiếng"
      ],
      "args": {
        "operation": "UNMUTE"
      }
    },
    {
      "id": "volume_max",
      "action": "VOLUME_SET",
      "patterns": [
        "âm lượng tối đa",
        "tăng âm lượng tối đa",
        "đặt âm lượng tối đa"
      ],
      "args": {
        "operation": "SET",
