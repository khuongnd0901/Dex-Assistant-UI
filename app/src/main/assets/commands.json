        "giảm âm lượng tối thiểu",
        "đặt âm lượng tối thiểu"
      ],
      "args": {
        "operation": "SET",
        "percent": 0
      }
    },
    {
      "id": "brightness_auto_true",
      "action": "BRIGHTNESS_SET",
      "patterns": [
        "bật độ sáng tự động"
      ],
      "args": {
        "operation": "AUTO_ON"
      }
    },
    {
      "id": "brightness_auto_false",
      "action": "BRIGHTNESS_SET",
      "patterns": [
        "tắt độ sáng tự động"
      ],
      "args": {
        "operation": "AUTO_OFF"
      }
    },
    {
      "id": "media_play",
      "action": "MEDIA_TRANSPORT",
      "patterns": [
        "phát nhạc",
        "phát video",
        "tiếp tục nhạc",
        "tiếp tục video",
        "phát tiếp",
        "tiếp tục phát"
      ],
      "args": {
        "operation": "PLAY"
      }
    },
    {
      "id": "media_pause",
      "action": "MEDIA_TRANSPORT",
      "patterns": [
        "tạm dừng nhạc",
        "tạm dừng video",
        "tạm dừng"
      ],
      "args": {
        "operation": "PAUSE"
      }
    },
    {
      "id": "media_stop",
      "action": "MEDIA_TRANSPORT",
      "patterns": [
        "dừng nhạc",
        "dừng video",
        "dừng phát",
        "ngừng phát"
      ],
      "args": {
        "operation": "STOP"
      }
    },
    {
      "id": "media_next",
      "action": "MEDIA_TRANSPORT",
      "patterns": [
        "bài tiếp theo",
        "video tiếp theo",
        "chuyển bài tiếp theo",
        "bài sau",
        "video sau"
      ],
      "args": {
        "operation": "NEXT"
      }
    },
    {
      "id": "media_previous",
      "action": "MEDIA_TRANSPORT",
      "patterns": [
        "bài trước",
        "video trước",
        "quay lại bài trước",
        "bài vừa rồi",
        "video vừa rồi"
      ],
      "args": {
        "operation": "PREVIOUS"
      }
    },
    {
      "id": "youtube_search",
      "action": "YOUTUBE_SEARCH",
      "patterns": [
        "mở youtube tìm {query}",
        "tìm youtube {query}",
        "tìm youtube bài {query}",
        "nhạc {query}",
        "tìm nhạc {query}",
        "mở youtube tìm nhạc {query}",
        "tìm video {query}",
        "tìm kiếm nhạc {query}",
        "tìm kiếm video {query}",
        "tìm {query} trên youtube",
        "tìm kiếm {query} trên youtube",
        "tìm {query} trên you tube",
        "tìm kiếm {query} trên you tube"
      ],
      "slots": {
        "query": {
          "type": "TEXT",
          "required": true
        }
      }
    },
    {
      "id": "youtube_play_query",
      "action": "YOUTUBE_PLAY_QUERY",
      "patterns": [
        "mở nhạc {query}",
        "phát trên youtube {query}",
        "mở youtube phát {query}"
      ],
      "slots": {
        "query": {
          "type": "TEXT",
          "required": true
        }
      }
    },
    {
      "id": "youtube_select_index",
      "action": "YOUTUBE_SELECT",
      "patterns": [
        "mở video số {index}",
        "chọn video số {index}",
        "phát kết quả số {index}"
      ],
      "slots": {
        "index": {
          "type": "INTEGER",
          "required": true
        }
      },
      "scope": {
        "apps": [
          "youtube"
        ]
      }
    },
    {
      "id": "youtube_select_title",
      "action": "YOUTUBE_SELECT",
      "patterns": [
        "chọn video {title}"
      ],
      "slots": {
        "title": {
          "type": "TEXT",
          "required": true
        }
      },
      "scope": {
        "apps": [
          "youtube"
        ]
      }
    },
    {
      "id": "youtube_fullscreen_true",
      "action": "YOUTUBE_FULLSCREEN",
      "patterns": [
        "toàn màn hình"
      ],
      "args": {
        "enabled": true
      },
      "scope": {
        "apps": [
          "youtube"
        ]
      }
    },
    {
      "id": "youtube_fullscreen_false",
      "action": "YOUTUBE_FULLSCREEN",
      "patterns": [
        "thoát toàn màn hình"
      ],
      "args": {
        "enabled": false
      },
      "scope": {
        "apps": [
          "youtube"
        ]
      }
    },
    {
      "id": "seek_forward",
      "action": "MEDIA_SEEK",
      "patterns": [
        "tua tới {seconds}",
        "tua tiến {seconds}"
      ],
      "slots": {
        "seconds": {
          "type": "DURATION",
          "required": true
        }
      },
      "args": {
        "operation": "FORWARD"
      },
      "scope": {
        "apps": [
          "youtube",
          "youtube_music"
        ]
      }
    },
    {
      "id": "seek_backward",
      "action": "MEDIA_SEEK",
      "patterns": [
        "tua lùi {seconds}"
      ],
      "slots": {
        "seconds": {
          "type": "DURATION",
          "required": true
        }
      },
      "args": {
        "operation": "BACKWARD"
      },
      "scope": {
        "apps": [
          "youtube",
          "youtube_music"
        ]
      }
    },
    {
      "id": "navigate",
      "action": "NAVIGATE",
      "patterns": [
