{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dexassistant.local/schemas/command-catalog-1.json",
  "title": "Bundled command catalog schema 1",
  "description": "Structural schema. CommandRegistry/ActionCatalog additionally validate placeholders, collisions, configured scopes and per-action typed parameters. Policies are APK code.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "configVersion",
    "minimumAppVersion",
    "apps",
    "commands",
    "interactions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "configVersion": {
      "type": "integer",
      "minimum": 1
    },
    "minimumAppVersion": {
      "type": "integer",
      "minimum": 1
    },
    "apps": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "packageName",
          "aliases"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "packageName": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"
          },
          "aliases": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "patterns"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "action": {
            "enum": [
              "APP_LAUNCH",
              "WIFI_SET",
              "BLUETOOTH_SET",
              "VOLUME_SET",
              "BRIGHTNESS_SET",
              "MEDIA_TRANSPORT",
              "YOUTUBE_SEARCH",
              "YOUTUBE_PLAY_QUERY",
              "YOUTUBE_SELECT",
              "YOUTUBE_FULLSCREEN",
              "MEDIA_SEEK",
              "SEARCH_PLACE",
              "NAVIGATE",
              "CALL_CONTACT",
              "CALL_NUMBER",
              "WEB_SEARCH",
              "CLICK_TEXT",
              "SCROLL",
              "FEED_NEXT",
              "FEED_PREVIOUS",
              "SYSTEM_ACTION",
              "APP_PAIR_LAUNCH"
            ]
          },
          "patterns": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "slots": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "required"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "TEXT",
                    "APP_ALIAS",
                    "INTEGER",
                    "PERCENT",
                    "DURATION",
                    "PHONE_NUMBER"
                  ]
                },
                "required": {
                  "const": true
                }
              }
            }
          },
          "args": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "integer",
                "boolean"
              ]
            }
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "apps"
            ],
            "properties": {
              "apps": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "priority": {
            "type": "integer",
            "minimum": -100,
            "maximum": 100
          },
          "allowCompound": {
            "type": "boolean",
            "description": "Permit a whole-input compound connector only for typed app-pair actions without free-text slots."
          }
        }
      }
          },
    "interactions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confirm",
        "cancel",
        "select"
      ],
      "properties": {
        "confirm": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cancel": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "select": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "next": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "previous": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
